    "markers": [
      {
        "finding_number": 1,
        "line": 27,
        "marker": "## Finding 1 — A single ~108.8 ka oscillation dominates the δ¹⁸O record, and it is a property of the proxy rather than of the age axis",
        "heading_level": 2
      },
      {
        "finding_number": 2,
        "line": 69,
        "marker": "## Finding 2 — The oscillation's phase is stable, its period is only weakly resolved, and its amplitude is not constant",
        "heading_level": 2
      },
      {
        "finding_number": 3,
        "line": 100,
        "marker": "## Finding 3 — The dual age coordinates differ only over the top 8.3% of the core and the divergence does not propagate into any record-wide result",
        "heading_level": 2
      },
      {
        "finding_number": 4,
        "line": 133,
        "marker": "## Finding 4 — The ~241 ka accumulation-rate maximum is a real feature of the supplied depth-age model, but it is not evidence for a sedimentation event",
        "heading_level": 2
      },
      {
        "finding_number": 5,
        "line": 167,
        "marker": "## Finding 5 — The proxy-variability/accumulation coupling is an arithmetic artefact, but accumulation rate and proxy *level* are genuinely coupled at block scale",
        "heading_level": 2
      }
    ],
