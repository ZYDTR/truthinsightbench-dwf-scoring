    "markers": [
      {
        "finding_number": 1,
        "line": 40,
        "marker": "### Finding 1 — Environmental positivity is a property of the sampled unit, not of the sampled site; site-level labels carry no recoverable location signal",
        "heading_level": 3
      },
      {
        "finding_number": 2,
        "line": 101,
        "marker": "### Finding 2 — Positivity concentrates at low quantitative assay values, but as a threshold step rather than a graded dose–response",
        "heading_level": 3
      },
      {
        "finding_number": 3,
        "line": 163,
        "marker": "### Finding 3 — The apparent 4-fold protective effect of later illness day is a design artefact; no threshold-free day or stay-day association survives blocking",
        "heading_level": 3
      },
      {
        "finding_number": 4,
        "line": 226,
        "marker": "### Finding 4 — Symptom status is uninformative about unit environmental positivity, while surface positivity is a strict subset of environmental positivity",
        "heading_level": 3
      },
      {
        "finding_number": 5,
        "line": 287,
        "marker": "### Finding 5 — The clustering constraint changes conclusions, not just their precision: it is the failure boundary of this dataset",
        "heading_level": 3
      }
    ],
