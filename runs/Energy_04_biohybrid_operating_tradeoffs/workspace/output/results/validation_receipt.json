    "markers": [
      {
        "finding_number": 1,
        "line": 80,
        "marker": "### Finding 1 — `time_response_curves.tsv` is three concatenated regimes, and the `time` column is a valid axis for only 2.6% of rows",
        "heading_level": 3
      },
      {
        "finding_number": 2,
        "line": 170,
        "marker": "### Finding 2 — The sweep regime shows path dependence (hysteresis) that is strongly channel-dependent and absent from one channel",
        "heading_level": 3
      },
      {
        "finding_number": 3,
        "line": 252,
        "marker": "### Finding 3 — The `condition_a`–`condition_b` coupling is regime-conditional: a genuine null in the baseline regime, and almost entirely a shared trajectory in the tail regime",
        "heading_level": 3
      },
      {
        "finding_number": 4,
        "line": 338,
        "marker": "### Finding 4 — The fitted columns are derived and strictly monotone; they are not independent observations and cannot be counted twice",
        "heading_level": 3
      },
      {
        "finding_number": 5,
        "line": 430,
        "marker": "### Finding 5 — The dose scan cannot identify an optimum (unresolved), while the perturbation trajectories give a clear, well-separated and control-stable response ordering",
        "heading_level": 3
      }
    ],
